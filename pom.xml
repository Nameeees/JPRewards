<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     JPRewards - pom.xml (Maven)
     Un solo .jar para Minecraft 1.8 hasta la ultima version.
     Se compila contra la API de Spigot 1.8.8 y no se usa NMS:
     materiales, sonidos, particulas y titulos se resuelven en
     tiempo de ejecucion (ver util/Compat.java).

       mvn clean package   ->  target/JPRewards-<version>.jar
     ============================================================ -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>me.jp</groupId>
    <artifactId>jprewards</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>JPRewards</name>
    <description>Daily, weekly, monthly and streak rewards with fully configurable head menus (1.8 - latest).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <!-- Build reproducible: el mismo codigo produce el mismo .jar y el
             mismo SHA-256, para que cualquiera pueda verificar la descarga. -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <repositories>
        <!-- API de Spigot 1.8.8: la base mas antigua soportada. -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- PaperMC publica la API de Spigot y las dependencias que Spigot
             dejo de servir (bungeecord-chat), para que el build funcione en
             cualquier maquina y en CI sin tocar el repositorio local. -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI: solo para COMPILAR el hook (scope provided).
             No se empaqueta nada suyo en el .jar. -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <!-- Solo la usa la API de chat de BungeeCord: el action bar y
                     los titulos se envian por reflexion (ver util/Compat). -->
                <exclusion>
                    <groupId>net.md-5</groupId>
                    <artifactId>bungeecord-chat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- target/JPRewards-2.0.0.jar -->
        <finalName>${project.name}-${project.version}</finalName>

        <resources>
            <!-- Los YAML no se filtran: contienen & y placeholders {asi}. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
            <!-- plugin.yml si: ${version} se sustituye por la version real. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>8</release>
                    <compilerArgs>
                        <arg>-Xlint:-options</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <!-- Un plugin no necesita el pom embebido, y dejarlo
                             fuera evita que retocar el pom cambie el .jar. -->
                        <addMavenDescriptor>false</addMavenDescriptor>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
