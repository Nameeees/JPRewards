root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{py,js,json}]
indent_size = 2

[*.{ps1,psm1}]
end_of_line = crlf

[*.bat]
end_of_line = crlf
