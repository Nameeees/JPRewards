# Copia este archivo a .env (no se sube al repositorio) y rellena lo que necesites.
#
# Numero que aparece en la URL de tu recurso:
#   https://www.spigotmc.org/resources/mi-recurso.123456/  ->  123456
SPIGOT_RESOURCE_ID=

# Opcional: si los dejas vacios, la primera vez se abre el navegador para que
# inicies sesion a mano y la sesion queda guardada en .sesion.json.
SPIGOT_USER=
SPIGOT_PASS=
